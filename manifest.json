{
  "manifest_version": 3,
  "name": "ICPC Tracker",
  "version": "0.13.0",
  "description": "A local-first tracker for student progress in Codeforces group contests.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "ICPC Tracker",
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/group/*/contest/*/standings*",
        "https://codeforces.com/contest/*/standings*",
        "https://codeforces.com/group/*/contests*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://codeforces.com/*"
  ]
}